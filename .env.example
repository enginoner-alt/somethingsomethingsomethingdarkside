# Copy to .env and fill in. Never commit .env.

# Hostname users open in the browser. Must be covered by your certificate.
SITE_ADDRESS=rec.example.com
# Paths inside deploy/certs (mounted at /certs). Put your wildcard cert there.
# For a quick local test without a real cert: SITE_ADDRESS=localhost and CADDY_TLS=internal
CADDY_TLS=/certs/fullchain.pem /certs/privkey.pem

# Generate with: openssl rand -hex 24   (hex keeps it URL-safe)
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-at-least-32-random-characters

# Break-glass local admin, created on first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-too
# Set to true once to reset the admin password to the value above, then back to false.
BOOTSTRAP_ADMIN_RESET=false

# Local test account (regular user, not admin) for trying things out.
# Set a password to create it on start; leave empty for no test account.
# Disable/enable it in Admin → Users. A restart never re-enables it.
TEST_ACCOUNT_USERNAME=test
TEST_ACCOUNT_PASSWORD=

APP_NAME=Darkside
DEFAULT_LOCALE=en

# --- Login safety (defaults shown) ---
# SESSION_IDLE_TIMEOUT_SECONDS=7200
# LOGIN_MAX_FAILURES_PER_USER_IP=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900
# "all" = any local account may use a password (POC default).
# "break_glass_only" = only BOOTSTRAP_ADMIN_USERNAME may; everyone else uses SSO.
LOCAL_LOGIN_MODE=all

# --- Optional SSO via OIDC (Keycloak, Authentik, Entra ID, ...) ---
# Leave OIDC_ISSUER empty to turn SSO off (POC default).
# In your IdP, register redirect URI https://<SITE_ADDRESS>/auth/oidc/callback
# and post-logout redirect URI https://<SITE_ADDRESS>/login.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=SSO
# Only members of this group may log in (recommended when SSO is on).
# OIDC_REQUIRED_GROUP=darkside-users
# Members of this group become admins (re-checked at every login).
# OIDC_ADMIN_GROUP=darkside-admins
# Group values are matched exactly (case-insensitive): a name such as
# "darkside-admins" (with AD: have the IdP send sAMAccountName), a full DN
# such as "CN=darkside-admins,OU=Groups,DC=corp,DC=local", or an Entra GUID.
# Claim holding the groups: "groups" (Keycloak, Authentik), "memberOf" (many
# AD-backed IdPs), "roles" (Entra ID App Roles), ...
# OIDC_GROUPS_CLAIM=groups
# How the client secret is sent: auto (default: from the IdP's discovery),
# client_secret_basic, or client_secret_post.
# OIDC_TOKEN_AUTH_METHOD=auto
# OIDC_USERNAME_CLAIM=preferred_username
