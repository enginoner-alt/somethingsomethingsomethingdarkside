# Copy to .env and fill in. Never commit .env.

# Hostname users open in the browser. Must be covered by your certificate.
SITE_ADDRESS=rec.example.com
# Paths inside deploy/certs (mounted at /certs). Put your wildcard cert there.
# For a quick local test without a real cert: SITE_ADDRESS=localhost and CADDY_TLS=internal
CADDY_TLS=/certs/fullchain.pem /certs/privkey.pem

# Generate with: openssl rand -hex 24   (hex keeps it URL-safe)
POSTGRES_PASSWORD=change-me
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-at-least-32-random-characters

# Break-glass local admin, created on first start.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-too
# Set to true once to reset the admin password to the value above, then back to false.
BOOTSTRAP_ADMIN_RESET=false

APP_NAME=Darkside
DEFAULT_LOCALE=en
